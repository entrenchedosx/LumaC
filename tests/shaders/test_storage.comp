/* Phase 21 storage-image fixture: writes a deterministic gradient
 * through an imageStore (PART O proof). Push carries width/height. */
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;
layout(push_constant) uniform Params {
    uint width;
    uint height;
} params;
void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= params.width || xy.y >= params.height) {
        return;
    }
    vec4 color = vec4(float(xy.x) / float(params.width),
                      float(xy.y) / float(params.height), 0.25, 1.0);
    imageStore(outImage, ivec2(xy), color);
}
